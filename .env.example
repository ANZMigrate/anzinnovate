# Set these only in Vercel Project Settings > Environment Variables (Production).
# Never commit real SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=ANZInnovate <no-reply@anzinnovate.com>
# Optional: true for implicit TLS on port 465, false for STARTTLS (e.g. 587).
# SMTP_SECURE=false
# All enquiries are sent to the fixed mailbox info@anzinnovate.com.
